{
	"luci-app-fluxdown": {
		"description": "Grant access to FluxDown configuration",
		"read": {
			"uci": [ "fluxdown" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/usr/libexec/fluxdown/luci-token": [ "exec" ],
				"/usr/libexec/fluxdown/luci-setup-code": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "fluxdown" ]
		}
	}
}
