#!/bin/sh
# FluxDown Server 群晖套件生命周期脚本（DSM 6 / DSM 7 通用）。
# DSM 7 由套件专属用户 sc-fluxdown 运行（conf/privilege run-as package），var 目录
# 归属该用户；DSM 6 以 root 运行。数据/日志均落在 /var/packages/FluxDown/var。
PKG_NAME="FluxDown"
PKG_DIR="/var/packages/${PKG_NAME}"
TARGET_DIR="${SYNOPKG_PKGDEST:-${PKG_DIR}/target}"
VAR_DIR="${SYNOPKG_PKGVAR:-${PKG_DIR}/var}"
PID_FILE="${VAR_DIR}/fluxdown-server.pid"
LOG_FILE="${VAR_DIR}/fluxdown-server.log"

is_running() {
	[ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

# DSM 7：向导选定的共享文件夹（postinst 落在 var/share_name，data-share worker
# 已授权 sc-fluxdown）。解析成绝对路径喂给 FLUXDOWN_SAVE_DIR 作首次默认保存目录；
# 否则套件用户没有 HOME/Downloads，服务器只会回退到不可写的 cwd。
# 优先 DSM ≥7.0-41201 提供的 /var/packages/<pkg>/shares/<name> 软链，
# 再回退扫 /volume*/<name>。解析不到就留空 → 服务器走平台默认。
resolve_share_dir() {
	name_file="${VAR_DIR}/share_name"
	[ -r "$name_file" ] || return 0
	name=$(tr -d '\r\n' < "$name_file")
	[ -n "$name" ] || return 0
	link="${PKG_DIR}/shares/${name}"
	if [ -d "$link" ]; then
		printf '%s' "$link"
		return 0
	fi
	for vol in /volume*; do
		if [ -d "${vol}/${name}" ]; then
			printf '%s' "${vol}/${name}"
			return 0
		fi
	done
}

start_server() {
	mkdir -p "$VAR_DIR"
	# FLUXDOWN_INSTALL_SOURCE：二进制归套件中心管理，应用内更新只提示安装新 spk
	FLUXDOWN_DATA_DIR="$VAR_DIR" \
	FLUXDOWN_BIND="[::]:17800" \
	FLUXDOWN_INSTALL_SOURCE=synology \
	FLUXDOWN_SAVE_DIR="$(resolve_share_dir)" \
		"$TARGET_DIR/bin/fluxdown-agent" --server >> "$LOG_FILE" 2>&1 &
	echo $! > "$PID_FILE"
}

stop_server() {
	if [ -f "$PID_FILE" ]; then
		kill "$(cat "$PID_FILE")" 2>/dev/null
		# SIGTERM → agent 优雅退出并关停 fluxdownd；最多等 10s
		i=0
		while is_running && [ "$i" -lt 10 ]; do
			sleep 1
			i=$((i + 1))
		done
		is_running && kill -9 "$(cat "$PID_FILE")" 2>/dev/null
		rm -f "$PID_FILE"
	fi
}

case "$1" in
	start)
		if is_running; then
			exit 0
		fi
		start_server
		exit 0
		;;
	stop)
		stop_server
		exit 0
		;;
	status)
		if is_running; then
			exit 0
		else
			exit 3
		fi
		;;
	*)
		exit 0
		;;
esac
