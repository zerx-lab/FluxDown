# opencommit 项目级配置模板 —— 复制为 .env 后生效
# 让 oco 生成的 commit 遵循 cliff.toml（Conventional Commits，规则见 commitlint.config.cjs）
OCO_PROMPT_MODULE=@commitlint
# Windows PowerShell 不导出 PWD，opencommit 的 @commitlint 模块依赖它定位
# .opencommit-commitlint；置为 . 使其落在仓库根目录（Git Bash/Linux 下无副作用）
PWD=.

# qwen-mt 翻译（task i18n:mt；阿里云百炼 API Key，勿提交真实值）
# DASHSCOPE_API_KEY=sk-...
# QWEN_MT_MODEL=qwen-mt-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼对 qwen-mt 按主账号限流（RPM 60；TPM plus 25000 / flash 35000 / lite 100000），客户端按此匀速；额度调整后再改
# QWEN_MT_RPM=60
# QWEN_MT_TPM=25000
