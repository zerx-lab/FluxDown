# 仓库行尾符策略:入库统一 LF(text 规范化),源码类型全平台强制 LF 检出。
# 存量 CRLF 文件不整库重写(不做 renormalize),在各自下次被修改时自然规范化。
* text=auto

# 源码/文本类型:全平台检出 LF
*.dart text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.astro text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.xcconfig text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.iss text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.cmake text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.hpp text eol=lf
*.m text eol=lf
*.swift text eol=lf
linux/*.desktop text eol=lf

