---
/**
 * 站点顶栏:沿页面导轨(rails)延伸的细线外框;下拉菜单纯 CSS(hover / focus-within),
 * 移动端菜单使用原生 Popover API(零 JS)。`D` 快捷键命中 `data-shortcut="d"` 的下载按钮。
 * 导航与操作区文字一律不换行;放不下时由内联脚本按 `data-compact` 逐级收起
 * (搜索文字 → 赞助文字 → 账户文字 → 整个桌面导航改汉堡菜单),适配任意语言的文案宽度。
 * AI 助手入口(`data-ai-entry`,桌面导航与移动菜单各一处)缺省隐藏,由 `<html data-ai-visible>` 放行,
 * 显隐规则与来源见 `src/lib/account/ai-entry.ts`;显隐变化后顶栏要重新计算收起步骤。
 */
import { ArrowRight, ChevronDown, Menu, Moon, Search, Sun, UserRound, X, Languages } from "lucide-react";
import { BrandIcon } from "../icons/brand";
import Logo from "./Logo.astro";
import { common } from "../../i18n/messages/common";
import { href, switchLang, stripLang } from "../../i18n/routing";
import { HREFLANG, HTML_LANG, LANG_LABEL, LANGS, type Lang } from "../../i18n/config";
import { COMMUNITY_LINKS, GITHUB_URL, PRODUCT_LINKS, SPONSOR_LINK, docsPath, navHref } from "../../lib/site-nav";
import { stripBase } from "@/lib/base";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = common[lang];
const path = stripLang(Astro.url.pathname);
// 语言切换:每种语言一条(当前语言标记 aria-current),href 保持当前页路径
const langItems = LANGS.map((l) => ({
  lang: l,
  label: LANG_LABEL[l],
  href: switchLang(Astro.url.pathname, l),
  current: l === lang,
}));

const menus = [
  {
    id: "product",
    label: t.nav.product,
    links: PRODUCT_LINKS,
    featured: {
      href: href("/download", lang),
      title: t.nav.featuredProduct,
      desc: t.nav.featuredProductDesc,
      cta: t.nav.featuredProductCta,
      external: false,
    },
  },
  {
    id: "community",
    label: t.nav.community,
    links: COMMUNITY_LINKS,
    featured: {
      href: GITHUB_URL,
      title: t.nav.featuredCommunity,
      desc: t.nav.featuredCommunityDesc,
      cta: t.nav.featuredCommunityCta,
      external: true,
    },
  },
];
// 产品特色卡的平台图标行:点明下载页覆盖的全部平台
const featuredPlatforms = ["apple", "windows", "linux", "docker", "android"] as const;
const flat = [
  { label: t.nav.docs, href: href(docsPath(lang), lang), active: stripBase(Astro.url.pathname).startsWith("/docs") },
  { label: t.nav.pricing, href: href("/pricing", lang), active: path.startsWith("/pricing") },
  { label: t.nav.changelog, href: href("/changelog", lang), active: path.startsWith("/changelog") },
  { label: t.nav.assistant, href: href("/assistant", lang), active: path.startsWith("/assistant"), aiEntry: true },
];
const sponsor = {
  label: t.nav[SPONSOR_LINK.label],
  href: href(SPONSOR_LINK.path, lang),
  active: path.startsWith(SPONSOR_LINK.path),
};
const isActive = (links: typeof PRODUCT_LINKS) =>
  links.some((l) => !l.path.includes("#") && path.startsWith(l.path));
---

<header class="site-header">
  <div class="frame header-inner">
    <a href={href("/", lang)} class="header-logo flex items-center rounded-md" aria-label="FluxDown">
      <Logo size={22} />
    </a>

    <nav class="header-nav" aria-label="Main">
      {
        menus.map((menu) => (
          <div class="nav-item">
            <button type="button" class="nav-link" data-active={isActive(menu.links) || undefined} aria-haspopup="true">
              {menu.label}
              <ChevronDown size={13} strokeWidth={2} className="nav-caret" />
            </button>
            <div class="nav-panel">
              <div class="nav-panel-inner">
                <a
                  href={menu.featured.href}
                  class="nav-feature"
                  target={menu.featured.external ? "_blank" : undefined}
                  rel={menu.featured.external ? "noopener" : undefined}
                >
                  <span class="nav-feature-art" data-kind={menu.id} aria-hidden="true">
                    {menu.id === "product" ? (
                      <span class="flex flex-col items-center gap-3">
                        <span class="nav-feature-bar">
                          <i /><i /><i /><i />
                        </span>
                        <span class="nav-feature-platforms">
                          {featuredPlatforms.map((name) => (
                            <BrandIcon name={name} size={13} />
                          ))}
                        </span>
                      </span>
                    ) : (
                      <BrandIcon name="github" size={26} />
                    )}
                  </span>
                  <span class="flex flex-1 flex-col gap-1.5 p-3.5">
                    {menu.id === "product" && <span class="nav-feature-badge">{t.nav.newBadge}</span>}
                    <span class="text-[13.5px] font-medium leading-snug text-fg">{menu.featured.title}</span>
                    <span class="text-[12.5px] leading-relaxed text-subtle">{menu.featured.desc}</span>
                    <span class="nav-feature-cta">
                      {menu.featured.cta}
                      <ArrowRight size={13} strokeWidth={2} />
                    </span>
                  </span>
                </a>
                <div class="nav-links">
                  {menu.links.map((link) => (
                    <a href={navHref(link, lang)} class="nav-entry">
                      <span class="nav-entry-icon">
                        <link.icon size={15} strokeWidth={1.75} />
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block whitespace-nowrap text-[13.5px] font-medium text-fg">{t.nav[link.label]}</span>
                        {link.desc && <span class="block truncate text-[12px] text-subtle">{t.nav[link.desc]}</span>}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))
      }
      {
        flat.map((item) => (
          <a href={item.href} class="nav-link" data-active={item.active || undefined} data-ai-entry={item.aiEntry || undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={sponsor.href} class="nav-link nav-sponsor" data-active={sponsor.active || undefined}>
        <SPONSOR_LINK.icon size={14} strokeWidth={2} className="nav-sponsor-icon" aria-hidden="true" />
        <span class="nav-sponsor-label">{sponsor.label}</span>
      </a>
    </nav>

    <div class="header-actions ml-auto flex items-center gap-1.5">
      <button type="button" class="search-trigger hidden md:inline-flex" data-palette-open aria-label={t.search.open}>
        <Search size={14} strokeWidth={2} />
        <span class="search-label text-[13px]">{t.search.open}</span>
        <span class="kbd ml-3">⌘K</span>
      </button>
      <a href={GITHUB_URL} class="icon-btn hidden sm:inline-grid" aria-label={t.nav.github} target="_blank" rel="noopener">
        <BrandIcon name="github" size={16} />
      </a>
      <div class="lang-menu hidden sm:block">
        <button type="button" class="icon-btn" aria-haspopup="true" aria-label={LANG_LABEL[lang]} title={LANG_LABEL[lang]}>
          <Languages size={16} strokeWidth={1.75} />
        </button>
        <div class="lang-panel">
          <ul class="lang-panel-inner">
            {
              langItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="lang-option"
                    lang={HTML_LANG[item.lang]}
                    hreflang={HREFLANG[item.lang]}
                    data-lang-switch={item.lang}
                    aria-current={item.current ? "true" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <button type="button" class="icon-btn header-theme" data-theme-toggle aria-label={t.theme.toggle}>
        <Sun size={16} strokeWidth={1.75} className="theme-sun" />
        <Moon size={16} strokeWidth={1.75} className="theme-moon" />
      </button>
      <a
        href={href("/account", lang)}
        class="btn btn-secondary btn-sm account-btn ml-1.5 hidden sm:inline-flex"
        data-account-link
        data-label-in={t.nav.account}
      >
        <UserRound size={14} strokeWidth={1.75} aria-hidden="true" />
        <span data-account-text>{t.nav.signIn}</span>
        <span class="account-dot" aria-hidden="true"></span>
      </a>
      <a href={href("/download", lang)} class="btn btn-primary btn-sm ml-1.5" data-shortcut="d">
        {t.nav.download}
        <span class="kbd hidden sm:inline-grid">D</span>
      </a>
      <button type="button" class="icon-btn header-menu-btn" popovertarget="mobile-nav" aria-label={t.nav.menu}>
        <Menu size={18} strokeWidth={1.75} />
      </button>
    </div>
  </div>
</header>

<!--
  顶栏自适应:文字不换行,溢出时按步骤逐级收起(写入 header 的 data-compact,空格分隔、累积)。
  内联同步执行,首帧前完成;窗口宽度或字体加载变化、AI 助手入口显隐变化(事件名同 ai-entry.ts::AI_ENTRY_EVENT)时重算。
  无 JS 时退化为不换行 + lg 断点切换。
-->
<script is:inline>
  (function () {
    var header = document.querySelector(".site-header");
    var inner = header && header.querySelector(".header-inner");
    if (!inner) return;
    var steps = ["search", "sponsor", "account", "nav"];
    function fit() {
      var applied = [];
      header.setAttribute("data-compact", "");
      for (var i = 0; i < steps.length && inner.scrollWidth > inner.clientWidth; i++) {
        applied.push(steps[i]);
        header.setAttribute("data-compact", applied.join(" "));
      }
    }
    fit();
    if ("ResizeObserver" in window) new ResizeObserver(fit).observe(inner);
    else window.addEventListener("resize", fit);
    window.addEventListener("fd:ai-visible", fit);
    if (document.fonts) document.fonts.ready.then(fit);
  })();
</script>

<div id="mobile-nav" popover class="mobile-nav">
  <div class="flex h-[var(--header-h)] items-center justify-between border-b border-line px-5">
    <Logo size={22} />
    <button type="button" class="icon-btn" popovertarget="mobile-nav" popovertargetaction="hide" aria-label={t.nav.close}>
      <X size={18} strokeWidth={1.75} />
    </button>
  </div>
  <div class="overflow-y-auto px-5 pb-10 pt-4">
    <a href={href("/download", lang)} class="btn btn-primary btn-lg mb-6 w-full">{t.nav.download}</a>
    {
      [...flat].map((item) => (
        <a href={item.href} class="mobile-link" data-ai-entry={item.aiEntry || undefined}>
          {item.label}
        </a>
      ))
    }
    <a href={sponsor.href} class="mobile-link">
      <SPONSOR_LINK.icon size={16} strokeWidth={1.75} className="nav-sponsor-icon" />
      {sponsor.label}
    </a>
    <a
      href={href("/account", lang)}
      class="mobile-link"
      data-account-link
      data-label-in={t.nav.account}
    >
      <UserRound size={16} strokeWidth={1.75} className="text-subtle" />
      <span data-account-text>{t.nav.signIn}</span>
      <span class="account-dot" aria-hidden="true"></span>
    </a>
    {
      menus.map((menu) => (
        <div class="mt-6">
          <div class="eyebrow-plain mb-2">{menu.label}</div>
          {menu.links.map((link) => (
            <a href={navHref(link, lang)} class="mobile-link">
              <link.icon size={16} strokeWidth={1.75} className="text-subtle" />
              {t.nav[link.label]}
            </a>
          ))}
        </div>
      ))
    }
    <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-line pt-6">
      {
        langItems
          .filter((item) => !item.current)
          .map((item) => (
            <a
              href={item.href}
              class="btn btn-secondary btn-sm"
              lang={HTML_LANG[item.lang]}
              hreflang={HREFLANG[item.lang]}
              data-lang-switch={item.lang}
            >
              <Languages size={14} strokeWidth={1.75} />
              {item.label}
            </a>
          ))
      }
      <a href={GITHUB_URL} class="btn btn-secondary btn-sm" target="_blank" rel="noopener">
        <BrandIcon name="github" size={14} />
        GitHub
      </a>
    </div>
  </div>
</div>

<!--
  账户入口:静态页拿不到登录态,读非 HttpOnly 的提示 Cookie `fd_signed_in=1`(同 src/lib/account/client.ts::SIGNED_IN_COOKIE,
  只决定显示「登录」还是「账户」,不作鉴权)。内联同步执行,首帧前完成切换;无 Cookie 时什么都不改。
-->
<script is:inline>
  (function () {
    var signedIn = document.cookie.split(";").some(function (part) {
      return part.trim() === "fd_signed_in=1";
    });
    if (!signedIn) return;
    document.querySelectorAll("[data-account-link]").forEach(function (el) {
      el.setAttribute("data-signed-in", "");
      var label = el.getAttribute("data-label-in");
      if (!label) return;
      if (el.hasAttribute("aria-label")) el.setAttribute("aria-label", label);
      if (el.hasAttribute("title")) el.setAttribute("title", label);
      var text = el.querySelector("[data-account-text]");
      if (text) text.textContent = label;
    });
  })();
</script>

<script>
  import { refreshAiEntryVisibility } from "../../lib/account/ai-entry";

  document.addEventListener("click", (event) => {
    if ((event.target as Element | null)?.closest("[data-palette-open]")) {
      window.dispatchEvent(new CustomEvent("palette:open"));
    }
  });

  // AI 助手入口:首帧已按缓存放行(Layout.astro 内联脚本),这里取最新结果并刷新缓存
  void refreshAiEntryVisibility();
</script>

<style is:global>
  @layer components {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      height: var(--header-h);
      background: color-mix(in oklch, var(--bg) 78%, transparent);
      backdrop-filter: saturate(1.6) blur(14px);
      -webkit-backdrop-filter: saturate(1.6) blur(14px);
      border-bottom: 1px solid transparent;
      transition: border-color 200ms;
    }
    .site-header[data-scrolled] {
      border-bottom-color: var(--line);
    }
    /* 阅读进度:底边一道随页面滚动增长的强调色细线(仅支持滚动时间线的浏览器) */
    .site-header::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent) 30%, var(--cyan));
      transform-origin: 0 50%;
      scale: 0 1;
      pointer-events: none;
    }
    @supports (animation-timeline: scroll()) {
      .site-header::after {
        animation: header-progress linear both;
        animation-timeline: scroll(root);
      }
      @keyframes header-progress {
        to {
          scale: 1 1;
        }
      }
    }
    .header-inner {
      display: flex;
      align-items: center;
      gap: 20px;
      height: 100%;
      padding-inline: clamp(14px, 2vw, 22px);
    }
    /* 超窄屏(<360px,英文「Download」更宽):收紧间距并让出主题按钮(页脚仍有),避免右侧菜单按钮被挤出视口 */
    @media (max-width: 359px) {
      .header-inner {
        gap: 10px;
      }
      .header-inner .header-theme {
        display: none;
      }
    }
    .header-logo,
    .header-actions {
      flex: none;
    }
    .header-nav {
      display: none;
      flex: none;
      align-items: center;
      gap: 2px;
    }
    @media (min-width: 1024px) {
      .header-nav {
        display: flex;
      }
    }
    .site-header[data-compact~="nav"] .header-nav {
      display: none;
    }
    /* 收起的文字仍留给读屏:视觉隐藏而非 display:none,绝对定位也不占 flex gap */
    .site-header[data-compact~="search"] .search-label,
    .site-header[data-compact~="sponsor"] .nav-sponsor-label,
    .site-header[data-compact~="account"] .account-btn [data-account-text] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .site-header[data-compact~="search"] .search-trigger .kbd {
      display: none;
    }
    .site-header[data-compact~="search"] .search-trigger,
    .site-header[data-compact~="account"] .account-btn {
      justify-content: center;
      width: 32px;
      padding-inline: 0;
    }
    .nav-item {
      position: relative;
      flex: none;
    }
    .nav-link {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 4px;
      height: 32px;
      padding-inline: 10px;
      border-radius: 7px;
      font-size: 13.5px;
      white-space: nowrap;
      color: var(--fg-muted);
      transition:
        color 150ms,
        background-color 150ms;
    }
    .nav-link:hover,
    .nav-item:focus-within > .nav-link,
    .nav-link[data-active] {
      color: var(--fg);
    }
    .nav-link:hover {
      background: var(--bg-inset);
    }
    .nav-sponsor-icon {
      color: var(--danger);
      transition: transform 240ms var(--ease-spring);
    }
    .nav-sponsor:hover .nav-sponsor-icon {
      fill: currentColor;
      transform: scale(1.12);
    }
    .nav-caret {
      opacity: 0.6;
      transition: transform 200ms var(--ease-out);
    }
    .nav-item:hover .nav-caret,
    .nav-item:focus-within .nav-caret {
      transform: rotate(180deg);
    }
    .nav-panel {
      position: absolute;
      left: -12px;
      top: 100%;
      padding-top: 12px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px) scale(0.985);
      transform-origin: 40px 0;
      transition:
        opacity 160ms,
        transform 240ms var(--ease-out),
        visibility 0s 240ms;
    }
    .nav-item:hover .nav-panel,
    .nav-item:focus-within .nav-panel {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 60ms, 60ms, 0s;
    }
    /* 悬停桥:按钮与面板之间的空隙不丢 hover */
    .nav-panel::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 12px;
    }
    .nav-panel-inner {
      display: grid;
      grid-template-columns: 216px 460px;
      gap: 6px;
      width: max-content;
      padding: 6px;
      border-radius: 14px;
      background: var(--bg-elev);
      box-shadow:
        0 0 0 1px var(--line),
        var(--shadow-float);
    }
    .nav-links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-content: start;
      gap: 2px;
      padding: 2px;
    }
    .nav-feature {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border-radius: 10px;
      background: var(--bg-sunken);
      box-shadow: 0 0 0 1px var(--line) inset;
      transition: box-shadow 200ms;
    }
    .nav-feature:hover {
      box-shadow: 0 0 0 1px var(--accent-line) inset;
    }
    .nav-feature-art {
      position: relative;
      display: grid;
      place-items: center;
      height: 92px;
      border-bottom: 1px solid var(--line);
      color: var(--fg-muted);
      background:
        radial-gradient(var(--line-strong) 1px, transparent 1px) 0 0 / 12px 12px,
        radial-gradient(ellipse 70% 80% at 50% 100%, var(--accent-soft), transparent 70%);
    }
    .nav-feature-bar {
      position: relative;
      width: 128px;
      height: 8px;
      overflow: hidden;
      border-radius: 99px;
      background: var(--bg-inset);
      box-shadow: 0 0 0 1px var(--line-strong) inset;
    }
    .nav-feature-bar i {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--n) * 25%);
      width: 25%;
      background: var(--accent);
      transform-origin: left;
      animation: nav-seg 2.8s var(--ease-out) infinite;
      animation-delay: calc(var(--n) * 0.12s);
    }
    .nav-feature-bar i:nth-child(1) { --n: 0; }
    .nav-feature-bar i:nth-child(2) { --n: 1; }
    .nav-feature-bar i:nth-child(3) { --n: 2; }
    .nav-feature-bar i:nth-child(4) { --n: 3; }
    @keyframes nav-seg {
      0% {
        transform: scaleX(0);
      }
      60%,
      100% {
        transform: scaleX(0.96);
      }
    }
    .nav-feature-platforms {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--fg-subtle);
      transition: color 200ms;
    }
    .nav-feature:hover .nav-feature-platforms {
      color: var(--fg-muted);
    }
    .nav-feature-cta {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin-top: auto;
      padding-top: 6px;
      font-size: 12.5px;
      font-weight: 520;
      color: var(--accent-ink);
    }
    .nav-feature-cta svg {
      transition: transform 200ms var(--ease-out);
    }
    .nav-feature:hover .nav-feature-cta svg {
      transform: translateX(3px);
    }
    .nav-feature-badge {
      align-self: flex-start;
      padding: 1px 7px;
      border-radius: 99px;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-fg);
      background: var(--accent);
    }
    .nav-entry {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 9px 10px;
      border-radius: 9px;
      transition: background-color 140ms;
    }
    .nav-entry:hover,
    .nav-entry:focus-visible {
      background: var(--bg-sunken);
    }
    .nav-entry-icon {
      display: grid;
      flex: none;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      color: var(--fg-muted);
      background: var(--bg-elev);
      box-shadow:
        0 0 0 1px var(--line-strong) inset,
        0 1px 2px oklch(0 0 0 / 0.04);
      transition: color 140ms;
    }
    .nav-entry:hover .nav-entry-icon {
      color: var(--accent-ink);
    }
    .icon-btn {
      display: inline-grid;
      place-items: center;
