---
/**
 * 顶部公告条:最新一条进行中、非弹窗公告。服务端直出目标语言;
 * 紧随其后的内联脚本在首帧前按 localStorage 关闭记录移除本条,关闭按钮写入记录。
 */
import { X, ArrowRight } from "lucide-react";
import { barAnnouncement, DISMISSED_KEY } from "@/lib/announcements";
import { href } from "@/i18n/routing";
import type { Lang } from "@/i18n/config";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const item = barAnnouncement();
const t = {
  en: { label: "Announcement", cta: "Take a look", close: "Dismiss announcement" },
  zh: { label: "公告", cta: "去看看", close: "关闭公告" },
}[lang];
---

{
  item && (
    <div
      class="ann-bar"
      id="announcement-bar"
      data-id={item.id}
      data-ends-at={item.endsAt ?? ""}
      role="region"
      aria-label={t.label}
    >
      <div class="frame ann-inner">
        <span class="live-dot shrink-0" aria-hidden="true" />
        <time class="ann-date" datetime={item.date}>{item.date}</time>
        <p class="ann-text">
          {item.link ? (
            <a href={href(item.link, lang)} class="ann-link" data-ann-dismiss>
              <span>{item.text[lang]}</span>
              <span class="ann-cta">
                {t.cta}
                <ArrowRight size={13} strokeWidth={2} aria-hidden="true" />
              </span>
            </a>
          ) : (
            item.text[lang]
          )}
        </p>
        <button type="button" class="ann-close" aria-label={t.close} data-ann-dismiss>
          <X size={14} strokeWidth={2} aria-hidden="true" />
        </button>
      </div>
    </div>
  )
}
{
  item && (
    <script is:inline define:vars={{ key: DISMISSED_KEY }}>
      (function () {
        var bar = document.getElementById("announcement-bar");
        if (!bar) return;
        var id = bar.getAttribute("data-id");
        var endsAt = bar.getAttribute("data-ends-at");
        if (endsAt) {
          var endMs = Date.parse(endsAt);
          if (Number.isFinite(endMs) && Date.now() > endMs) {
            bar.remove();
            return;
          }
        }
        function read() {
          try {
            var list = JSON.parse(localStorage.getItem(key) || "[]");
            return Array.isArray(list) ? list : [];
          } catch (e) {
            return [];
          }
        }
        if (id && read().indexOf(id) !== -1) {
          bar.remove();
          return;
        }
        bar.addEventListener("click", function (event) {
          var trigger = event.target.closest("[data-ann-dismiss]");
          if (!trigger) return;
          var list = read();
          if (id && list.indexOf(id) === -1) list.push(id);
          try {
            localStorage.setItem(key, JSON.stringify(list));
          } catch (e) {}
          if (trigger.tagName === "BUTTON") bar.remove();
        });
      })();
    </script>
  )
}

<style>
  .ann-bar {
    position: relative;
    border-bottom: 1px solid var(--line);
    background: var(--bg-sunken);
    font-size: 13px;
  }
  .ann-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 38px;
    padding: 6px 8px 6px 16px;
  }
  .ann-date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    color: var(--fg-subtle);
  }
  .ann-text {
    flex: 1;
    min-width: 0;
    color: var(--fg-muted);
  }
  .ann-link {
    display: inline;
    transition: color 160ms;
  }
  .ann-link:hover {
    color: var(--fg);
  }
  .ann-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 10px;
    white-space: nowrap;
    color: var(--accent-ink);
  }
  .ann-link:hover .ann-cta :global(svg) {
    transform: translateX(2px);
  }
  .ann-cta :global(svg) {
    transition: transform 200ms var(--ease-out);
  }
  .ann-close {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--fg-subtle);
    transition: color 160ms, background-color 160ms;
  }
  .ann-close:hover {
    color: var(--fg);
    background: var(--bg-inset);
  }
  @media (max-width: 640px) {
    .ann-date {
      display: none;
    }
  }
</style>
