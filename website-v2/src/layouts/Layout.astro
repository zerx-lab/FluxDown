---
/**
 * 全站基础布局:SEO 头、主题预绘制、字体预加载、外壳(Header / Footer / 命令面板)。
 *
 * - 语言由页面显式传入(URL 决定);hreflang 默认按当前路径生成 en/zh 双向簇,
 *   docs 等自有语言结构的页面传 `alternates` 覆盖,无变体页面传 `alternates={[]}`。
 * - 无前缀(英文)页面是「自动语言」入口:首帧前按用户显式选择 → 浏览器/系统语言
 *   判定,偏好中文则 replace 到 /zh/ 对应页。/zh/ 与 docs 是显式语言 URL,不跳;
 *   爬虫不跳(英文页保持可索引)。
 * - `chrome={false}` 用于需要整屏自管的工具页(只保留 <head> 与主题)。
 */
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import CommandPalette from "../components/site/CommandPalette";
import AnnouncementBar from "../components/site/AnnouncementBar.astro";
import AnnouncementPopup from "../components/site/AnnouncementPopup";
import { SITE_ORIGIN, OG_IMAGE_URL, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT, HOME_META, buildGraph } from "../lib/seo";
import { HREFLANG, HTML_LANG, LANGS, OG_LOCALE, type Lang } from "../i18n/config";
import { common } from "../i18n/messages/common";
import { PRODUCT_LINKS, COMMUNITY_LINKS, SPONSOR_LINK, docsPath, navHref } from "../lib/site-nav";
import { href, switchLang } from "../i18n/routing";
import { BASE, withBase } from "@/lib/base";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  canonicalUrl?: string;
  alternates?: { lang: string; href: string }[];
  noindex?: boolean;
  /** 与 noindex 同用:追加 nofollow(分享落地页等不应被爬取的动态页)。 */
  nofollow?: boolean;
  /** 页面级追加的 JSON-LD 节点(如 FAQPage / BreadcrumbList),并入全站 @graph。 */
  jsonLdNodes?: Record<string, unknown>[];
  ogImage?: string;
  chrome?: boolean;
}

const {
  lang,
  title = HOME_META[lang].title,
  description = HOME_META[lang].description,
  canonicalUrl,
  noindex: pageNoindex = false,
  nofollow = false,
  jsonLdNodes = [],
  ogImage = OG_IMAGE_URL,
  chrome = true,
} = Astro.props;

// 挂在子路径下的预览部署(如 /v2)整站 noindex,避免与根部署重复收录;base 回到 `/` 即自动恢复。
const noindex = pageNoindex || BASE !== "";

// pathname 已含挂载前缀,只拼站点源。
const pathname = Astro.url.pathname;
const normalizedPath = pathname === "/" ? "/" : `${pathname.replace(/\/$/, "")}/`;
const canonical = canonicalUrl ?? `${SITE_ORIGIN}${normalizedPath}`;

const alternates =
  Astro.props.alternates ??
  [
    ...LANGS.map((l) => ({ lang: HREFLANG[l], href: `${SITE_ORIGIN}${switchLang(normalizedPath, l)}` })),
    { lang: "x-default", href: `${SITE_ORIGIN}${switchLang(normalizedPath, "en")}` },
  ];

const t = common[lang];

// 命令面板数据:页面导航在服务端本地化后下发,文档索引由面板按需拉取。
const paletteLinks = [
  { label: t.nav.download, href: href("/download", lang) },
  { label: t.nav.docs, href: href(docsPath(lang), lang) },
  { label: t.nav.pricing, href: href("/pricing", lang) },
  { label: t.nav.faq, href: href("/faq", lang) },
  ...[...PRODUCT_LINKS, ...COMMUNITY_LINKS, SPONSOR_LINK].map((link) => ({
    label: t.nav[link.label],
    href: navHref(link, lang),
  })),
];

// 仅默认 hreflang 簇的英文页参与自动语言;自带 alternates 的页面(docs / 404 / 工具页)语言由 URL 固定。
const autoZhHref = lang === "en" && Astro.props.alternates === undefined ? switchLang(normalizedPath, "zh") : null;

// Google Analytics 4(媒体资源「FluxDown Website」,数据流 fluxdown.com):只在生产根部署加载,
// 本地 dev 与子路径预览部署不计数。
const GA_MEASUREMENT_ID = "G-B77V9DMYQT";
const loadAnalytics = import.meta.env.PROD && BASE === "";
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content={nofollow ? "noindex,nofollow" : "noindex"} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}

    <!-- 主题预绘制:在首帧前确定 data-theme,避免闪烁。默认跟随系统。 -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem("fluxdown-theme"); } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="icon" type="image/x-icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase("/logo.png")} />
    <meta name="theme-color" content="#0d0e11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f9fa" media="(prefers-color-scheme: light)" />
    <link rel="preload" href={withBase("/fonts/geist-normal-latin.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("/fonts/geist-mono-normal-latin.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase("/fonts/instrument-serif-italic-latin.woff2")} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FluxDown" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content="FluxDown — the download manager, rebuilt in Rust" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 自动语言:键名与 src/lib/locale-pref.ts 的 LOCALE_KEY 一致;判定规则与 lib/locale-detect.ts 对齐。
         zhHref 为 null 的页面(显式语言 URL)直接跳过。 -->
    <script is:inline define:vars={{ zhHref: autoZhHref }}>
      (function () {
        if (!zhHref) return;
        var pref = null;
        try { pref = localStorage.getItem("fluxdown-locale"); } catch (e) {}
        if (pref !== "en" && pref !== "zh") {
          var m = document.cookie.match(/(?:^|;\s*)fluxdown-locale=(en|zh)(?:;|$)/);
          pref = m ? m[1] : null;
        }
        if (!pref) {
          if (/bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)) return;
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ""];
          for (var i = 0; i < langs.length && !pref; i++) {
            var tag = String(langs[i]).toLowerCase();
            if (tag.indexOf("zh") === 0) pref = "zh";
            else if (tag.indexOf("en") === 0) pref = "en";
          }
        }
        if (pref === "zh") location.replace(zhHref + location.search + location.hash);
      })();
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(buildGraph(jsonLdNodes))} />
    {
      loadAnalytics && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} />
          <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class="page-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[100] focus:rounded-md focus:bg-elev focus:px-3 focus:py-2 focus:text-sm"
      >{t.skip}</a
    >
    {chrome && <AnnouncementBar lang={lang} />}
    {chrome && <Header lang={lang} />}
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer lang={lang} />}
    {
      chrome && (
        <CommandPalette
          client:idle
          lang={lang}
          links={paletteLinks}
          altLangHref={switchLang(normalizedPath, lang === "en" ? "zh" : "en")}
        />
      )
    }
    {chrome && <AnnouncementPopup client:idle lang={lang} />}

    <script>
      import "../scripts/motion.ts";
      import { isLang } from "../i18n/config";
      import { rememberLocale } from "../lib/locale-pref";

      // 语言切换器(Header / Footer 的 [data-lang-switch])点击即记为显式选择,之后不再按浏览器语言自动跳转。
      document.addEventListener(
        "click",
        (event) => {
          const target = event.target instanceof Element ? event.target.closest("[data-lang-switch]") : null;
          const lang = target?.getAttribute("data-lang-switch");
          if (isLang(lang)) rememberLocale(lang);
        },
        true,
      );
    </script>
    <!--
      LangBot 客服机器人组件(全站)。走同域代理 /api/langbot-widget.js:上游脚本注入的
      baseUrl 是 http://127.0.0.1:5300,直连会让所有请求打到访客本机。
    -->
    <script is:inline defer data-title="FD助手" src={withBase("/api/langbot-widget.js")}></script>
    <!-- Cloudflare Web Analytics（手动安装，不依赖区域代理的自动注入；区域侧须保持自动注入关闭以免重复计数） -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "a19315d531084052929d5123a1a64dbe"}'></script>
  </body>
</html>
