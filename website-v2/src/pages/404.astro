---
/**
 * 全站唯一 404(Astro 只支持一个根级 404)。页面静态预渲染,语言无法从 URL 得知,
 * 因此所有语言都直出,首帧前由内联脚本按语言前缀(先去掉站点挂载前缀)切换可见语言(并同步 <html lang> 与标题)。
 */
import Layout from "@/layouts/Layout.astro";
import BrokenDownload from "@/components/info/BrokenDownload.astro";
import { DEFAULT_LANG, HTML_LANG, LANGS } from "@/i18n/config";
import { href } from "@/i18n/routing";
import { guides } from "@/i18n/messages/guides";
import { docsPath } from "@/lib/site-nav";
import { BASE } from "@/lib/base";

// 非默认语言的前缀集合与各语言的 <html lang> / 标题,交给首帧内联脚本(无法 import)
const prefixLangs = LANGS.filter((lang) => lang !== DEFAULT_LANG);
const titles = Object.fromEntries(LANGS.map((lang) => [lang, `404 - ${guides[lang].notFound.title} - FluxDown`]));
---

<Layout lang="en" title="404 - FluxDown" description="Page not found." noindex alternates={[]}>
  <script is:inline define:vars={{ base: BASE, prefixLangs, htmlLang: HTML_LANG, titles }}>
    const sitePath = base && location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname;
    const prefix = sitePath.match(/^\/([^/]+)(?:\/|$)/);
    const lang = prefix && prefixLangs.includes(prefix[1]) ? prefix[1] : null;
    if (lang) {
      // 脚本先于文案节点执行:追加样式即可让目标语言在首帧直接可见
      const style = document.createElement("style");
      style.textContent = `html .nf-copy{display:none}html .nf-copy[data-l="${lang}"]{display:block}`;
      document.head.append(style);
      document.documentElement.lang = htmlLang[lang];
      document.title = titles[lang];
    }
  </script>

  <section class="frame">
    <div class="section grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:gap-16">
      <div>
        <span class="eyebrow">Error 404</span>
        <p class="nf-code num ink-gradient" aria-hidden="true">404</p>
        {
          LANGS.map((lang) => {
            const t = guides[lang].notFound;
            return (
              <div class="nf-copy" data-l={lang} data-default={lang === DEFAULT_LANG ? "" : undefined} lang={HTML_LANG[lang]}>
                <h1 class="h3">{t.title}</h1>
                <p class="lede mt-3 max-w-[46ch]">{t.desc}</p>
                <div class="mt-8 flex flex-wrap gap-3">
                  <a class="btn btn-primary" href={href("/", lang)}>
                    {t.home}
                  </a>
                  <a class="btn btn-secondary" href={href("/download", lang)}>
                    {t.download}
                  </a>
                  <a class="btn btn-ghost" href={href(docsPath(lang), lang)}>
                    {t.docs}
                  </a>
                  <a class="btn btn-ghost" href={href("/feedback", lang)}>
                    {t.feedback}
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
      <BrokenDownload readout={guides.en.notFound.readout} />
    </div>
  </section>
</Layout>

<style>
  .nf-code {
    margin-block: 8px 20px;
    font-size: clamp(5.5rem, 16vw, 10rem);
    font-weight: 560;
    line-height: 0.9;
    letter-spacing: -0.06em;
    user-select: none;
  }
  /* 默认语言直出;其余语言由内联脚本按 URL 前缀追加的样式显示 */
  .nf-copy:not([data-default]) {
    display: none;
  }
</style>
