---
import { ArrowRight } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import PricingPlans from "@/components/pricing/PricingPlans";
import CompareTable from "@/components/pricing/CompareTable.astro";
import CloudPromoBanner from "@/components/site/CloudPromoBanner.astro";
import { langStaticPaths, resolveLang, href } from "@/i18n/routing";
import { pricing } from "@/i18n/messages/pricing";
import { SAME_AS } from "@/lib/seo";

export const getStaticPaths = langStaticPaths;
const lang = resolveLang(Astro.params.lang);
const t = pricing[lang];
const serif = (s: string) => s.replace(/<em>(.*?)<\/em>/g, '<span class="serif">$1</span>');
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
  <CloudPromoBanner lang={lang} variant="pricing" />
  <PageHeader eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede}>
    <a class="btn btn-secondary" href={href("/pricing/why", lang)}>
      {t.hero.why}
      <ArrowRight size={15} aria-hidden="true" />
    </a>
    <a class="btn btn-ghost" href={href("/pricing/vote", lang)}>{t.hero.vote}</a>
  </PageHeader>

  <section class="frame" aria-labelledby="plans-heading">
    <div class="section-tight">
      <h2 id="plans-heading" class="sr-only">{t.plans.heading}</h2>
      <PricingPlans client:load lang={lang} downloadHref={href("/download", lang)} sourceHref={SAME_AS[0]} />
    </div>
    <div class="rule"></div>
  </section>

  <section class="frame" aria-labelledby="compare-heading">
    <div class="section grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-14">
      <div class="flex flex-col gap-5 lg:sticky lg:top-[calc(var(--header-h)+32px)] lg:self-start">
        <span class="eyebrow" data-scramble>{t.compare.eyebrow}</span>
        <h2 id="compare-heading" class="h2 text-[clamp(1.8rem,3.2vw,2.6rem)]" data-reveal set:html={serif(t.compare.title)} />
        <p class="lede" data-reveal style="--d:1">{t.compare.lede}</p>
        <a class="link w-fit text-sm" href={href("/pricing/why", lang)} data-reveal style="--d:2">{t.hero.why}</a>
      </div>
      <div data-reveal style="--d:1">
        <CompareTable lang={lang} />
      </div>
    </div>
    <div class="rule"></div>
  </section>

  <section class="frame" aria-labelledby="notes-heading">
    <div class="section">
      <div class="mb-10 flex flex-col gap-5">
        <span class="eyebrow" data-scramble>{t.notes.eyebrow}</span>
        <h2 id="notes-heading" class="h2 text-[clamp(1.8rem,3.2vw,2.6rem)]" data-reveal set:html={serif(t.notes.title)} />
      </div>
      <dl class="cells border border-line md:grid-cols-3">
        {
          t.notes.items.map((note, i) => (
            <div class="cell spot" data-reveal style={`--d:${i}`}>
              <dt class="flex items-baseline gap-3">
                <span class="num font-mono text-xs text-subtle">{String(i + 1).padStart(2, "0")}</span>
                <span class="text-[15px] font-semibold">{note.title}</span>
              </dt>
              <dd class="mt-3 text-sm leading-relaxed text-muted">{note.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="rule"></div>
  </section>

  <section class="frame" aria-labelledby="vote-cta-heading">
    <div class="section-tight flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div class="flex max-w-[60ch] flex-col gap-3">
        <span class="eyebrow">{t.voteCta.eyebrow}</span>
        <h2 id="vote-cta-heading" class="h3">{t.voteCta.title}</h2>
        <p class="text-sm leading-relaxed text-muted">{t.voteCta.desc}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href={href("/pricing/vote", lang)}>
          {t.voteCta.link}
          <ArrowRight size={15} aria-hidden="true" />
        </a>
        <a class="btn btn-ticks" href={href("/pricing/why", lang)}>{t.voteCta.why}</a>
      </div>
    </div>
    <div class="rule"></div>
  </section>
</Layout>

<style is:global>
  @layer components {
    /* Paid plans: accent hairline across the top edge of the cell. */
    .plan-featured::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 2px;
      background: var(--accent);
    }
    /* Empty grid slots keep the hatched gutter texture instead of a solid line block. */
    .cells > .plan-fill {
      background: repeating-linear-gradient(-45deg, var(--hatch) 0 1px, var(--bg) 1px 7px);
    }
  }
</style>
